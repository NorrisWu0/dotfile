{
  "lastChangelogVersion": "1.3.0",
  "theme": "dark",
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.1",
  "tuiMode": "fullscreen",
  "packages": [
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-subagents",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-lens"
  ],
  "subagents": {
    "agentOverrides": {
      "planner": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high"
      },
      "executor": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "high"
      }
    }
  }
}